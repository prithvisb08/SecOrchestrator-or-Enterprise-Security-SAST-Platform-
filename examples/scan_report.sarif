              }
            },
            {
              "id": "SEC-CODE-001",
              "name": "Unsafe Dynamic Code Execution",
              "shortDescription": {
                "text": "The use of eval() or exec() can allow attackers to execute arbitrary code if user input is passed to it."
              }
            },
            {
              "id": "SEC-CRYPTO-001",
              "name": "Weak Cryptographic Hash Function",
              "shortDescription": {
