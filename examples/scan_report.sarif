          "rules": [
            {
              "id": "SEC-CFG-ROOT-001",
              "name": "Container Runs as Root User",
              "shortDescription": {
                "text": "The Dockerfile does not switch to a non-privileged user, running processes as root by default."
              }
            },
            {
